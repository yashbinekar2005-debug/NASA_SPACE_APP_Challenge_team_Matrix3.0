# ---------------------------------------------------------------------------
# ASTRA Analog Finder - API configuration
# ---------------------------------------------------------------------------
# The default discovery pipeline uses only public, keyless scientific APIs:
#   NASA POWER, ISRIC SoilGrids, OpenTopoData (SRTM), Macrostrat,
#   BigDataCloud reverse geocoding and OpenStreetMap Overpass.
#
# You therefore do NOT need a key to run `node tools/discover.mjs`.
# Copy this file to `.env` and fill only the optional values you have.
# ---------------------------------------------------------------------------

# Optional. NASA Earthdata Login token.
# Get one: https://urs.earthdata.nasa.gov/ -> register -> Profile -> Generate Token
# Reserved for authenticated Earthdata downloads (SMAP, MODIS, etc.).
# The current pipeline does not read this value yet; public CMR works without it.
NASA_EARTHDATA_TOKEN=

# NASA POWER does not issue API keys. Do not add one; the endpoint is public.

# Optional. Raises the public OpenTopoData rate limit (1000 calls/day/IP).
# Get one: https://www.opentopodata.org/ (public API page -> request a key).
# The pipeline sends it as `Authorization: Bearer <key>`.
OPEN_TOPO_DATA_API_KEY=

# Optional. Commercial Open-Meteo key from https://open-meteo.com/en/pricing.
# Reserved; the current pipeline uses the free keyless endpoint and does not
# read this value yet.
OPEN_METEO_API_KEY=

# Not a key: your own contact address, sent in the User-Agent to OSM / Overpass.
# Please set a real contact for automated runs.
ASTRA_CONTACT_EMAIL=

# Optional. Override the Overpass mirror if the main endpoint is busy.
OVERPASS_URL=https://overpass-api.de/api/interpreter

# Optional. Cache directory and snapshot output (relative to this folder).
ASTRA_CACHE_DIR=.cache/astra
ASTRA_DISCOVERY_OUT=js/data/discovered.js
